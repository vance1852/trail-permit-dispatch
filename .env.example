# 复制为 .env 后按环境修改；不要提交真实凭据。

# HTTP 监听地址
HTTP_ADDR=:8080
# SQLite 数据源，目录会在启动时自动创建
DATABASE_DSN=file:data/trail-permit.sqlite
# 日志级别：debug / info / warn / error
LOG_LEVEL=info

# 会话有效期与优雅关闭
SESSION_TTL=12h
SHUTDOWN_TIMEOUT=15s
READ_HEADER_TIMEOUT=10s

# 后台执行器
WORKER_COUNT=2
WORKER_POLL_INTERVAL=500ms
WORKER_JOB_TIMEOUT=20s
JOB_LEASE_DURATION=30s
JOB_BACKOFF_BASE=2s
JOB_BACKOFF_MAX=5m
JOB_MAX_ATTEMPTS=5

# 业务参数
CHECKPOINT_GRACE_MINUTES=30
PERMIT_UNIT_FEE_CENTS=4500
IDEMPOTENCY_TTL=24h

# 空库初始化：仅在数据库中没有线路管理员时生效
SEED_ENABLED=true
SEED_RANGER_EMAIL=ranger@trailpermit.local
SEED_LEADER_EMAIL=leader@trailpermit.local
# 初始口令没有默认值。留空时系统会生成一次性口令并在启动日志中输出一次，
# 请登录后立即修改；生产环境建议通过密钥管理注入下面两个变量。
SEED_RANGER_PASSWORD=
SEED_LEADER_PASSWORD=
